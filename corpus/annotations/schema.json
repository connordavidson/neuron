{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuron.local/schemas/corpus-annotation-v1.json",
  "type": "object",
  "required": ["schemaVersion", "bookId", "title", "readingStartPage", "sections", "reviewers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bookId": { "type": "string" },
    "title": { "type": "string" },
    "readingStartPage": { "type": "integer", "minimum": 0 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "kind", "startPage", "level"],
        "properties": {
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "startPage": { "type": "integer", "minimum": 0 },
          "level": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "kind", "pageIndex"],
        "properties": {
          "text": { "type": "string" },
          "kind": {
            "enum": ["heading", "prose", "footnote", "caption", "table", "reference", "decorative"]
          },
          "pageIndex": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "bodyWordCount": { "type": "integer", "minimum": 0 },
    "runningFurniture": { "type": "array", "items": { "type": "string" } },
    "sentenceEnds": { "type": "array", "items": { "type": "string" } },
    "reviewers": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
